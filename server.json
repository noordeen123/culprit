{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.noordeen123/culprit",
  "title": "culprit",
  "description": "Deterministic, offline root-cause analysis: find the commit that introduced a bug and verify a fix is complete before committing.",
  "repository": {
    "url": "https://github.com/noordeen123/culprit",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "culprit",
      "version": "0.4.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "culprit[mcp]"
        },
        {
          "type": "positional",
          "value": "culprit-mcp"
        }
      ]
    }
  ]
}
